# Окружение: dev | prod | test
YII_ENV=dev
YII_DEBUG=1

# База данных (PostgreSQL рекомендуется; для MySQL: mysql:host=localhost;dbname=forest)
DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=forest"
DB_USER=forest
DB_PASSWORD=secret
DB_TEST_DSN="pgsql:host=127.0.0.1;port=5432;dbname=forest_test"

COOKIE_VALIDATION_KEY=change-me-to-random-string

# Почта
MAILER_DSN="smtp://user:pass@smtp.example.com:465"
MAILER_USE_FILE_TRANSPORT=1
ADMIN_EMAIL=admin@example.com
SENDER_EMAIL=noreply@example.com

# SMS-шлюз: file | http
SMS_DRIVER=file
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=LesLubvi

# Платёжный провайдер: fake | http
PAYMENT_DRIVER=fake
PAYMENT_API_URL=
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# IP провайдера, с которых принимаются вебхуки (через запятую; пусто — не проверять)
PAYMENT_WEBHOOK_IPS=

# Redis (опционально)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Базовый URL сайта (для ссылок в письмах и консольных командах)
APP_URL=https://forest.example.com
